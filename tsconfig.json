{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "public/js",
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "lib": ["DOM", "ES2020"],
    "allowJs": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
